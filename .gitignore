# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# SPAdes assemblies are huge — never commit
**/spades*/
**/_spades*/
**/k[0-9][0-9]*/
**/contigs.fasta
**/assembly_graph_after_simplification.gfa
**/contigs.paths

# Per-sample run outputs
**/blast_*.tsv
**/genome_cov_spades_*.txt
**/anchor_*.fasta
**/anchor_*.ann.tsv
**/bubble_alleles*.fasta
**/bubble_alleles*.ann.tsv
**/bubble_topology.tsv
**/cand_combined.fasta
**/cand_combined.ann.tsv
**/picker_candidates.fasta
**/picker_candidates.ann.tsv
**/primary_alleles*.fasta
**/picks*.tsv
**/identity*.tsv
**/consensus_qc.tsv
**/coverage.tsv
**/consensus_alleles.fasta
**/reads.sorted.bam
**/reads.sorted.bam.*
**/bubble.{txt,gfa,dot,tsv,png}
**/seg_labels_k*.tsv
**/queries/
**/logs/
**/input_process/

# Aggregate summary + cluster outputs
summary.tsv
clusters/
**/cores*.fasta
**/cores*.tsv
**/allele_classification.tsv
**/allele_distance_matrix.tsv

# Scratch directories
_*/
*_out/

# Example assets stored via git-lfs — explicitly UN-ignored so the
# bundled-with-the-repo demo data is committed (overrides the
# `**/k[0-9][0-9]*/`, `**/assembly_graph_after_simplification.gfa`,
# and `**/spades*/` rules above for content under examples/).
!examples/
!examples/**
!examples/**/*.gfa.gz
# ...but the decompressed *.gfa siblings the test harness creates from those
# *.gfa.gz are derived (regenerated on demand) — keep them out of git.
examples/**/assembly_graph_after_simplification.gfa

# Editor / OS
.DS_Store
*.bak
*.swp
*.swo
