{
  "_description": "Canonical run configuration for the Pcub40 demo test. These are the flags + implicit defaults the pipeline used to produce known_results.json.",
  "spades_dir":          "examples/Pcub40/<sample>",
  "locus_ref":           "examples/Pcub_locus/NC_062999.fasta",
  "proteins":            "examples/Pcub_locus/NC_062999_HDs.fasta",
  "ks":                  ["k45", "k53"],
  "expected_count":      2,
  "threads":             4,
  "skip_pick":           false,
  "skip_consensus":      true,
  "min_allele_bp":       0,
  "cov_filter":          "on",
  "seeds":               "both",
  "max_paths":           1000,
  "max_path_length":     50,
  "max_bp_since_var":    5000,
  "init_nhop":           3,
  "max_nhop":            8,
  "divergence_threshold": 0.01,
  "lo_mult":             0.2,
  "hi_mult":             2.0,
  "locus_padding":       4000,
  "contig_depth_size_cut": 5000,
  "genome_cov_source":   "GFA DP:f: median (estimate_genome_cov_from_gfa)",
  "blastn_pid":          80,
  "blastn_minlen":       100,
  "tblastn_pid":         30,
  "tblastn_aa":          50,
  "flank_pid":           85,
  "flank_minlen":        100,
  "min_allele_len":      2000
}
